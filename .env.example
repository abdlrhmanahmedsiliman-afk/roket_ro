# roket_ro — مفاتيح التطبيق
# القيم الحقيقية متتكتبش هنا ولا في الشات: بتتحط في GitHub → Settings → Secrets → Actions (الخطوات في ملف خطوات_السيرفرات_المجانية.md)
# الـ workflow بيكتب ملف .env من الأسرار وقت البناء.

# مساعد الذكاء الاصطناعي (Gemini) — الكود الحالي بيقرأ ده فقط
GEMINI_API_KEY=MY_GEMINI_API_KEY

# محجوزة لمزوّدي البيانات (يتم قراءتها عبر BuildConfig)
FOOTBALL_DATA_KEY=YOUR_FOOTBALL_DATA_KEY
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY
THESPORTSDB_KEY=123
