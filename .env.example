# ==============================================================================
# roket_ro Environment Variables & API Key Configuration
# All sensitive API keys can be set in the AI Studio Secrets Panel or exported.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Assistant & LLM Intelligence
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini 2.5 Flash analysis, tactical summaries & chat (Free Tier available in Google AI Studio)
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ANTHROPIC_API_KEY: Anthropic Claude 3.5 Sonnet backup assistant
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key

# ------------------------------------------------------------------------------
# 2. Football APIs (Primary & Backup)
# ------------------------------------------------------------------------------
# API-Football (RapidAPI): Fixtures, Live Events, Lineups, Rosters (Free tier: 100 requests/day free forever)
# Get free key from: https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=your_rapidapi_football_key_here
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# TheSportsDB: 100% FREE API key '3' for all public endpoints (Logos, badges, team history, stadiums)
# Endpoints: https://www.thesportsdb.com/api/v1/json/3/...
THESPORTSDB_API_KEY=3

# Football-Data.org: Free tier with 10 requests/minute, 12 top European leagues free
# Get free token from: https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_TOKEN=your_free_football_data_token

# ------------------------------------------------------------------------------
# 3. 100% FREE Multi-Sport Public APIs (No Credit Card Required)
# ------------------------------------------------------------------------------

# [BASKETBALL / NBA]
# 1) ESPN Public API: Completely FREE, no API key needed
#    URL: https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard
# 2) BallDontLie Free Tier API (NBA players, stats, games):
#    Get free key from: https://www.balldontlie.io
BALLDONTLIE_API_KEY=your_free_balldontlie_key
NBA_PUBLIC_API_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard

# [FORMULA 1 & MOTORSPORT]
# OpenF1 & Ergast: 100% FREE & Open Source, zero auth required!
# Telemetry, lap times, pit stops, live race positions
# OpenF1 Docs: https://openf1.org
OPENF1_API_ENDPOINT=https://api.openf1.org/v1
ERGAST_F1_API_ENDPOINT=https://ergast.com/api/f1/current/last/results.json

# [TENNIS (ATP / WTA / Grand Slams)]
# ESPN Tennis Free Public Scoreboard (Wimbledon, US Open, Roland Garros, Australian Open)
# No API key required!
TENNIS_PUBLIC_API_URL=https://site.api.espn.com/apis/site/v2/sports/tennis/atp/scoreboard

# [CRICKET (IPL, T20, ICC World Cup)]
# Free CricAPI: 100 calls/day free tier for live match scores & commentary
# Get free key from: https://cricapi.com
CRICAPI_KEY=your_free_cricapi_key_here

# [BASEBALL / MLB]
# MLB StatsAPI: 100% Official Free Public API from MLB
# No API key required!
# URL: https://statsapi.mlb.com/api/v1/schedule?sportId=1
MLB_PUBLIC_API_URL=https://statsapi.mlb.com/api/v1/schedule?sportId=1

# [AMERICAN FOOTBALL / NFL & ICE HOCKEY / NHL]
# ESPN Free Public Endpoints:
NFL_PUBLIC_API_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard
NHL_PUBLIC_API_URL=https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard

# ------------------------------------------------------------------------------
# 4. Real-Time Push Gateway, Redis Cache & Database
# ------------------------------------------------------------------------------
# WebSocket Realtime Gateway (Sub-2-second push server)
ROKET_RO_WS_URL=wss://live-push.roketro.app/ws/matches

# Redis Cache connection string (LRU L2 In-Memory Cache)
# Free cloud Redis available at: https://upstash.com or local Docker
REDIS_CACHE_URL=redis://:strong_password@127.0.0.1:6379/0

# Database Connection (PostgreSQL Microservices)
# Free cloud Postgres available at: https://supabase.com or https://neon.tech
DATABASE_URL=postgresql://roket_admin:secure_db_pass@localhost:5432/roket_ro_db?sslmode=require
